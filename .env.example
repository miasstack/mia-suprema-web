# LLM backend — FreeLLMAPI rotation engine on the Hermes VPS.
# HERMES_LLM_API_KEY is the unified key for the "agnes" account,
# found in the FreeLLMAPI dashboard at http://146.148.98.134:3000 -> Keys.
HERMES_LLM_BASE_URL=http://146.148.98.134:3000/v1
HERMES_LLM_API_KEY=
HERMES_LLM_MODEL=auto

# Supabase (optional - falls back to localStorage if not set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

